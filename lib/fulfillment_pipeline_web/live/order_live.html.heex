<.header>
  Fulfillment Pipeline Dashboard
</.header>

<.form
  for={@filter_form}
  id="order-filters"
  phx-change="filter"
  phx-submit="filter"
  class="flex flex-wrap items-end gap-4"
>
  <div class="grow">
    <.input
      field={@filter_form[:search]}
      type="search"
      placeholder="Search order # or customer"
      phx-debounce="300"
    />
  </div>
  <div class="w-48">
    <.input
      field={@filter_form[:status]}
      type="select"
      options={@statuses}
      prompt="All statuses"
    />
  </div>
</.form>

<table class="table table-zebra">
  <thead>
    <tr>
      <th><.sort_header field="order_number" label="Order #" filters={@filters} /></th>
      <th><.sort_header field="customer_name" label="Customer" filters={@filters} /></th>
      <th><.sort_header field="status" label="Status" filters={@filters} /></th>
      <th><.sort_header field="priority" label="Priority" filters={@filters} /></th>
      <th><.sort_header field="estimated_ship_date" label="Ship Date" filters={@filters} /></th>
      <th>Analysis</th>
      <th><span class="sr-only">Actions</span></th>
    </tr>
  </thead>
  <tbody id="pipeline-orders">
    <tr :if={@orders == []} id="no-orders">
      <td colspan="7" class="text-center text-gray-500 py-6">No orders match these filters.</td>
    </tr>
    <tr :for={order <- @orders} id={"order-row-#{order.id}"}>
      <td>
        <.link
          id={"order-link-#{order.id}"}
          navigate={~p"/orders/#{order.id}/edit"}
          class="underline hover:text-blue-600"
        >
          {order.order_number}
        </.link>
      </td>
      <td>{order.customer_name}</td>
      <td>
        <span style={"color: #{status_color(order.status)}"}>
          {order.status}
        </span>
      </td>
      <td>{order.priority}</td>
      <td>{order.estimated_ship_date}</td>
      <td>
        <%= if order.status == "exception" do %>
          <%= if order.exception_analysis && order.exception_analysis != "Analyzing..." do %>
            <span style="font-size: 0.75rem; color: #6b7280;">✓ Analysis available</span>
          <% else %>
            <.button
              phx-click="analyze_exception"
              phx-value-id={order.id}
              style="font-size: 0.75rem; padding: 2px 8px;"
            >
              {if order.exception_analysis == "Analyzing...", do: "Analyzing...", else: "Analyze"}
            </.button>
          <% end %>
        <% end %>
      </td>
      <td class="w-0 font-semibold">
        <div class="flex gap-4">
          <.button phx-click="advance" phx-value-id={order.id}>
            Advance
          </.button>
          <.button phx-click="trigger_exception" phx-value-id={order.id}>
            Exception
          </.button>
        </div>
      </td>
    </tr>
  </tbody>
</table>

<div id="pipeline-pagination" class="mt-4 flex items-center justify-between text-sm">
  <span id="page-summary">
    Page {@page.page_number} of {max(@page.total_pages, 1)} — {@page.total_entries} orders
  </span>
  <div class="flex gap-2">
    <.link
      :if={@page.page_number > 1}
      id="prev-page"
      patch={page_link(@filters, @page.page_number - 1)}
      class="px-3 py-1 rounded border hover:bg-gray-100"
    >
      ← Prev
    </.link>
    <.link
      :if={@page.page_number < @page.total_pages}
      id="next-page"
      patch={page_link(@filters, @page.page_number + 1)}
      class="px-3 py-1 rounded border hover:bg-gray-100"
    >
      Next →
    </.link>
  </div>
</div>

<%= for order <- @orders, order.status == "exception",
    order.exception_analysis && order.exception_analysis != "Analyzing..." do %>
  <div style="margin-top: 1.5rem; padding: 1rem; border: 1px solid #ef4444;
              border-radius: 8px; background: #fef2f2;">
    <div style="font-weight: 600; color: #ef4444; margin-bottom: 0.5rem;">
      Exception Analysis — {order.order_number}
    </div>
    <pre style="white-space: pre-wrap; font-size: 0.8rem; color: #374151;
                font-family: inherit;">{order.exception_analysis}</pre>
  </div>
<% end %>
