<.header>
  New Order
  <:actions>
    <.button id="back-to-orders" navigate={~p"/orders"}>
      <.icon name="hero-arrow-left" class="size-4" /> Back to orders
    </.button>
  </:actions>
</.header>

<.order_form
  changeset={@changeset}
  action={~p"/orders"}
  warehouses={@warehouses}
  carriers={@carriers}
/>
