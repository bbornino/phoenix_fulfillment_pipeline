<.header>
  Order {@order.order_number}
  <:actions>
    <.button id="back-to-orders" navigate={~p"/orders"}>
      <.icon name="hero-arrow-left" class="size-4" /> Back to orders
    </.button>
    <.button id="edit-order" navigate={~p"/orders/#{@order}/edit"}>Edit order</.button>
  </:actions>
</.header>

<div id="order-details">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-x-6">
    <.detail label="Order number" class="md:col-span-2">{@order.order_number}</.detail>
    <.detail label="Status">
      <span style={status_color(@order.status)}>{@order.status}</span>
    </.detail>
    <.detail label="Requires signature">
      {if @order.requires_signature, do: "Yes", else: "No"}
    </.detail>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6">
    <.detail label="Customer name">{@order.customer_name}</.detail>
    <.detail label="Customer email">{@order.customer_email}</.detail>
    <.detail label="Priority">{@order.priority}</.detail>
    <.detail label="Warehouse">
      {if @order.warehouse, do: @order.warehouse.name, else: "Unknown"}
    </.detail>
    <.detail label="Estimated ship date">{@order.estimated_ship_date}</.detail>
    <.detail label="Carrier">
      {if @order.carrier, do: @order.carrier.name, else: "Not assigned"}
    </.detail>
  </div>
  <.detail label="Tracking number">
    {if @order.tracking_number, do: @order.tracking_number, else: "Not assigned"}
  </.detail>
  <.detail label="Notes"><span class="whitespace-pre-wrap">{@order.notes}</span></.detail>
</div>
